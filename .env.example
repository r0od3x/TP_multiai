# Copy to .env at the repository root — load_dotenv() finds it from every TP folder

# Required — OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# TP1 — Groq models
GROQ_API_KEY=

# TP3 — web search tool (Tavily)
TAVILY_API_KEY=

# TP2 — RAG app tuning (optional)
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=16
RAG_TOP_K=5
